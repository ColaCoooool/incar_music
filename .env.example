# InCar Music Configuration

# Music library path (NAS mount point)
MUSIC_LIBRARY_PATH=/music

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/incar_music.db

# Cache settings
CACHE_DIR=./data/cache
HLS_DIR=./data/hls
COVER_DIR=./data/covers
MAX_CACHE_SIZE_MB=2048

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis (optional)
# REDIS_URL=redis://localhost:6379
